@page "/"
@using Sudoku_Solver_From_Scratch.Components.BackEnd;

@rendermode InteractiveServer

<h1>Sudoku Solver</h1>

<SudokuGrid Board="_board" @ref="_sudokuGrid"/>

<button class="btn btn-primary"
        @onclick="SolveSudoku">
    Solve
</button>

<button class="btn btn-primary"
        @onclick="ClearSudoku">
    Clear
</button>

@code {
    
    private SudokuBoard _board = new();
    
    private SudokuGrid _sudokuGrid = new();

    private async Task SolveSudoku()
    {
        _board.SolveSudoku();
        
        StateHasChanged();

        // Refocus the grid.
        await _sudokuGrid.FocusGrid();
    }

    private async Task ClearSudoku()
    {
        _board.Clear();
        
        StateHasChanged();
        
        // Refocus the grid.
        await _sudokuGrid.FocusGrid();
    }
}
