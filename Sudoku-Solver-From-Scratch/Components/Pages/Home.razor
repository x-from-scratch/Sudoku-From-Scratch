@page "/"
@using Sudoku_Solver_From_Scratch.Components.BackEnd;

@rendermode InteractiveServer

<h1>Sudoku Solver</h1>

<SudokuGrid Board="_board" />

<button class="btn btn-primary"
        @onclick="SolveSudoku">
    Solve
</button>

<button class="btn btn-primary"
        @onclick="ClearSudoku">
    Clear
</button>

@code {
    
    private SudokuBoard _board = new();

    private void SolveSudoku()
    {
        _board.SolveSudoku();
        
        StateHasChanged();
    }

    private void ClearSudoku()
    {
        _board.Clear();
        
        StateHasChanged();
    }
}
