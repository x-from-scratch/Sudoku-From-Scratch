@page "/"
@using Sudoku_Solver_From_Scratch.Components.BackEnd;

@rendermode InteractiveServer

<div class="sudoku-wrapper">
    <div class="sudoku-container">

        <SudokuGrid Board="_board" @ref="_sudokuGrid" />

        <div class="sudoku-controls">
            <button class="btn btn-primary" @onclick="SolveSudoku">
                Solve
            </button>

            <button class="btn btn-secondary" @onclick="ClearSudoku">
                Clear
            </button>
        </div>

    </div>
</div>

@code {
    
    private SudokuBoard _board = new();
    
    private SudokuGrid _sudokuGrid = new();

    private async Task SolveSudoku()
    {
        _board.SolveSudoku();
        
        StateHasChanged();

        // Refocus the grid.
        await _sudokuGrid.FocusGrid();
    }

    private async Task ClearSudoku()
    {
        _board.Clear();
        
        StateHasChanged();
        
        // Refocus the grid.
        await _sudokuGrid.FocusGrid();
    }
}
