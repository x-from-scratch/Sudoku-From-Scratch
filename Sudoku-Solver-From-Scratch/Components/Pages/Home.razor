@page "/"
@using Sudoku_Solver_From_Scratch.Components.BackEnd;

@rendermode InteractiveServer

<PageTitle>Sudoku</PageTitle>

<div class="sudoku-wrapper">
    <header class="sudoku-header">
        <h1>Sudoku Solver</h1>
    </header>

    <div class="sudoku-card">

        <div class="sudoku-board">
            <SudokuGrid Board="_board" @ref="_sudokuGrid" />
        </div>

        <aside class="sudoku-controls">
            <button class="sudoku-btn sudoku-btn--primary" @onclick="SolveSudoku">
                ✓ Solve
            </button>

            <button class="sudoku-btn sudoku-btn--secondary" @onclick="ClearSudoku">
                ✕ Clear
            </button>
        </aside>

    </div>
</div>


@code {
    
    private SudokuBoard _board = new();
    
    private SudokuGrid _sudokuGrid = new();

    private async Task SolveSudoku()
    {
        _board.SolveSudoku();
        
        StateHasChanged();

        // Refocus the grid.
        await _sudokuGrid.FocusGrid();
    }

    private async Task ClearSudoku()
    {
        _board.Clear();
        
        StateHasChanged();
        
        // Refocus the grid.
        await _sudokuGrid.FocusGrid();
    }
}
