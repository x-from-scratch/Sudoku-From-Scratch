@using Sudoku_Solver_From_Scratch.Components.BackEnd;

<div class="sudoku-grid">
    
<!-- Construct the grid -->
@for (int row = 0; row < 9; row++)
{
    int currentRow = row;
    
    @for (int col = 0; col < 9; col++)
    {
        int currentCol = col;
        
        <input type="number"
               min="1"
               max="9"
               class="@GetCellClass(row, col)"
               value="@Board.Grid[row, col]"
               @oninput="@(value => Board.SetCell(currentRow, currentCol, value))"/>
    }
}
</div>


@code {
    [Parameter]
    public SudokuBoard Board { get; set; } = new();

    private string GetCellClass(int row, int col)
    {
        string css = "sudoku-cell";

        if (col % 3 == 2 && col != 8)
            css += " right-border";

        if (row % 3 == 2 && row != 8)
            css += " bottom-border";
        
        // Assign background colour
        if (row >= 3 && row <= 5)
        {
            if (col <= 2 || col >= 6)
            {
                css += " white-cell";
            }
            else
            {
                css += " grey-cell";
            }
        }
        else
        {
            if (col <= 2 || col >= 6)
            {
                css += " grey-cell";
            }
            else
            {
                css += " white-cell";
            }
        }
        

        return css;
    }
}