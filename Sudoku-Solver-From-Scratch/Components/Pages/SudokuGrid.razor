@using Sudoku_Solver_From_Scratch.Components.BackEnd;

<!-- Used to change focus from the cells to itself. Doesn't work without tabindex. -->
<div class="sudoku-grid" @onkeydown="HandleKeyDown"
     tabindex="0"
     @ref="_gridReference">
    
<!-- Construct the grid -->
@for (int row = 0; row < 9; row++)
{
    int currentRow = row;
    
    @for (int col = 0; col < 9; col++)
    {
        int currentCol = col;
        
        <input type="number"
               min="1"
               max="9"
               class="@GetCellClass(row, col)"
               value="@(Board.Grid[row, col] != 0 ? Board.Grid[row, col] : "")"
               @ref="_cellReferences[currentRow, currentCol]"
               @oninput="value => CellInput(currentRow, currentCol, value)"
               @onkeydown:preventDefault="@_cellNotFocused"/>
    }
}
</div>


@code {
    [Parameter]
    public SudokuBoard Board { get; set; } = new();

    #region Attributes
    
    // Focusing and navigating functionality
    private int _selectedRow = 0;
    private int _selectedCol = 0;

    private bool _cellNotFocused = true;
    
    private readonly ElementReference[,] _cellReferences = new ElementReference[9, 9];
    private ElementReference _gridReference;
    
    #endregion
    
    // Set focus on the grid for the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusGrid();
        }
    }
    
    /// <summary>
    /// Returns the cell class in css.
    /// </summary>
    /// <param name="row">The cell's row</param>
    /// <param name="col">The cell's column</param>
    /// <returns></returns>
    private string GetCellClass(int row, int col)
    {
        
        string css = "sudoku-cell";

        if (col % 3 == 2 && col != 8)
            css += " right-border";

        if (row % 3 == 2 && row != 8)
            css += " bottom-border";
        
        // Assign background colour
        if (row >= 3 && row <= 5)
        {
            if (col <= 2 || col >= 6)
            {
                css += " white-cell";
            }
            else
            {
                css += " grey-cell";
            }
        }
        else
        {
            if (col <= 2 || col >= 6)
            {
                css += " grey-cell";
            }
            else
            {
                css += " white-cell";
            }
        }

        
        if (row == _selectedRow && col == _selectedCol)
            css += " selected-cell";

        if (row == _selectedRow ^ col == _selectedCol)
            css += " highlighted-cell";
        
        // Check if the cell is bold or not.
        if (Board.UserInput[row, col])
        {
            css += " user-input";
        }
        
        // Check if the cell is correctly inputted:
        if (Board.WrongCell[row, col])
        {
            css += " wrong-cell";
        }

        return css;
    }

    /// <summary>
    /// Changes the sudoku grid and sets inputted cells' font to bold.
    /// </summary>
    /// <param name="row"></param>
    /// <param name="col"></param>
    /// <param name="e"></param>
    private void CellInput(int row, int col, ChangeEventArgs e)
    {
        // Assert the user has input the correct number.
        
        /*
         * Check for those thins:
         * - The input is just one digit long.
         * - The input is an integer.
         * - The input does not exceed 9.
         */
        
        string input = e.Value?.ToString() ?? "";

        if (input.Length != 1 ||
            !int.TryParse(input, out int number) ||
            number < 1 || number > 9)
        {
            Board.Grid[row, col] = 0;
            Board.UserInput[row, col] = false;
            return;
        }
        
        Board.SetCell(row, col, number);
        
        Board.UserInput[row, col] = Board.Grid[row, col] != 0;
        
        Board.UpdateSafeness();
    }
    
    /// <summary>
    /// Either changes focus or navigates through cells.
    /// </summary>
    /// <param name="e"></param>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Change focus:
        if (e.Key == "Enter")
        {
            _cellNotFocused = !_cellNotFocused;
            
            // Stop moving cells while one cell is focused.
            if (!_cellNotFocused)
            {
                await FocusCell(_selectedRow, _selectedCol);
                return;
            }
            else
            {
             await FocusGrid();   
            }
        }

        if (!_cellNotFocused)
            return;
        
        switch (e.Key)
        {
            case "ArrowUp":
                _selectedRow = Math.Max(0, _selectedRow - 1);
                break;

            case "ArrowDown":
                _selectedRow = Math.Min(8, _selectedRow + 1);
                break;

            case "ArrowLeft":
                _selectedCol = Math.Max(0, _selectedCol - 1);
                break;

            case "ArrowRight":
                _selectedCol = Math.Min(8, _selectedCol + 1);
                break;
        }
    }
    
    /// <summary>
    /// Focuses the cell at row and column.
    /// </summary>
    /// <param name="row"></param>
    /// <param name="col"></param>
    private async Task FocusCell(int row, int col)
    {
        await _cellReferences[row, col].FocusAsync();
    }

    /// <summary>
    /// Focuses the grid.
    /// </summary>
    public async Task FocusGrid()
    {
        await _gridReference.FocusAsync();
    }
    
}